SITE_URL=http://localhost:3000

# --- Entrega dos formulários (contato, pré-cadastro de membro, parceria) ---
# Configure PELO MENOS um canal. Se nenhum for definido, os envios são apenas
# registrados no log do servidor (útil em desenvolvimento).

# Opção mais fácil: webhook do Discord. Crie em
# Configurações do canal > Integrações > Webhooks > Novo webhook > Copiar URL.
DISCORD_WEBHOOK_URL=

# Opção por email: chave da API do Resend (https://resend.com) + destinatário.
# SUBMISSIONS_EMAIL_FROM é opcional (padrão: onboarding@resend.dev).
RESEND_API_KEY=
SUBMISSIONS_EMAIL_TO=
SUBMISSIONS_EMAIL_FROM=
